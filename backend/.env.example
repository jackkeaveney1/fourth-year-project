# Copy to .env and fill in for a real (non-scripted) agent run.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Set to 1 to force the deterministic ScriptedLLMClient stub instead of
# calling a real model (useful for demos/CI without an API key). Leaving
# ANTHROPIC_API_KEY unset has the same effect.
USE_SCRIPTED_LLM=0
