# Copy to .env and fill in ONE of these for a real (non-scripted) agent run.
# Aion Labs is checked first if set — OpenAI-compatible chat completions API:
# https://www.aionlabs.ai/docs/
AIONLABS_API_KEY=
AIONLABS_MODEL=aion-labs/aion-2.0

# Groq is checked next if set. Free tier, real tool calling, and it
# actually cooperates with the pentest-agent framing this project needs:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Blue-team uses a different Groq model so it draws from its own daily
# token quota instead of competing with the red-team run for the same one.
GROQ_BLUE_MODEL=openai/gpt-oss-120b

# Gemini is used next if neither of the above is set and this is set. Free tier,
# get a key at https://aistudio.google.com/apikey — NOTE: Gemini's own
# safety training refuses the red-team agent's "attack a target" framing
# outright — confirmed via live runs even with explicit academic/CTF/sandbox
# framing and relaxed safety_settings, so it's not a prompting problem. Only
# really works for the blue-team (defensive) role. Fallback, not primary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic is used last, if neither of the above is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Set to 1 to force the deterministic ScriptedLLMClient stub instead of
# calling a real model (useful for demos/CI without an API key). Leaving
# both API keys unset has the same effect.
USE_SCRIPTED_LLM=0
